{
  "name": "Portifolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:debug": "turbo run dev:debug",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:cov": "turbo run test:cov",
    "test:debug": "turbo run test:debug",
    "test:e2e": "turbo run test:e2e",
    "deploy": "turbo run deploy",
    "contract:emit": "turbo run contract:emit",
    "migration:plan": "turbo run migration:plan",
    "db:migrate": "turbo run db:migrate",
    "db:verify": "turbo run db:verify",
    "docker:infra": "docker compose --profile tools up -d",
    "docker:infra:down": "docker compose --profile tools down",
    "docker:infra:down:clean": "docker compose --profile tools down -v",
    "docker:up": "docker compose --profile tools --profile app up -d",
    "docker:down": "docker compose --profile tools --profile app down",
    "docker:down:clean": "docker compose --profile tools --profile app down -v"
  },
    "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
